{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "layer-shell": true,
  "cssPriority": "application",
  "control-center-margin-top": 5,
  "control-center-margin-bottom": 5,
  "control-center-margin-right": 5,
  "control-center-margin-left": 5,
  "control-center-layer": "overlay",
  "control-center-exclusive-zone": true,
  "notification-2fa-action": true,
  "timeout": 5,
  "timeout-low": 3,
  "timeout-critical": 10,
  "notification-window-width": 400,
  "notification-window-height": 500,
  "notification-window-preferred-output": "",
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-height": 500,
  "control-center-width": 350,
  "control-center-preferred-output": "",
  "layer-shell-cover-screen": true,
  "notification-inline-replies": false,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-visibility": {
    "Spotify": {
      "state": "muted",
      "urgency": "Low",
      "app-name": "Spotify",
      "desktop-entry": "spotify.desktop"
    }
  },
  "widgets": [
    "menubar#power",
    "menubar",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "inhibitors",
    "title",
    "notifications",
    "dnd"
  ],
  "widget-config": {
    "menubar": {
      "buttons#wifi-bt": {
        "position": "left",
        "actions": [
          {
            "label": " WiFi",
            "type": "toggle",
            "active": true,
            "command": "sh -c '~/.config/swaync/scripts/toggle_wifi.sh'",
            "update-command": "sh -c 'set +e;[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
          },
          {
            "label": "\udb82\udd6d",
            "type": "normal",
            "active": false,
            "command": "nm-connection-editor"
          },
          {
            "label": "󰂯 Bluetooth",
            "type": "toggle",
            "active": true,
            "command": "sh -c '~/.config/swaync/scripts/toggle_bluetooth.sh'",
            "update-command": "sh -c 'set +e;bluetoothctl show | grep -qF Powered:\\ yes && echo true || echo false'"
          },
          {
            "label": "\udb82\udd6d",
            "type": "normal",
            "active": false,
            "command": "blueman-manager"
          }
        ]
      }
    },
    "menubar#power": {
      "buttons#power-toggle": {
        "position": "left",
        "actions": [
          {
            "label": "⚡Profiles",
            "type": "toggle",
            "active": true,
            "command": "powerprofilesctl set balanced",
            "update-command": "sh -c 'set +e;[[ $(powerprofilesctl get) == \"balanced\" ]] && echo true || echo false'"
          }
        ]
      },
      "menu#power-arrow": {
        "label": "\udb82\udd6d",
        "position": "left",
        "animation-type": "slide_down",
        "animation-duration": 250,
        "actions": [
          {
            "label": " Performance",
            "type": "toggle",
            "command": "powerprofilesctl set performance",
            "update-command": "sh -c 'set +e;[[ $(powerprofilesctl get) == \"performance\" ]] && echo true || echo false'"
          },
          {
            "label": " Balanced",
            "type": "toggle",
            "command": "powerprofilesctl set balanced",
            "update-command": "sh -c 'set +e;[[ $(powerprofilesctl get) == \"balanced\" ]] && echo true || echo false'"
          },
          {
            "label": " Power Saver",
            "type": "toggle",
            "command": "powerprofilesctl set power-saver",
            "update-command": "sh -c 'set +e;[[ $(powerprofilesctl get) == \"power-saver\" ]] && echo true || echo false'"
          }
        ]
      },
      "buttons#weather": {
        "position": "right",
        "actions": [
          {
            "label": " \udb81\udd93 ",
            "type": "normal",
            "active": false,
            "command": "sh -c '~/.config/swaync/scripts/show_weather.sh'"
          }
        ]
      }
    },
    "inhibitors": {
      "text": "Inhibitors",
      "button-text": "",
      "clear-all-button": true
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "󰎟"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "label": {
      "max-lines": 5,
      "text": "Label Text"
    },
    "mpris": {
      "blacklist": [],
      "autohide": true,
      "show-album-art": "always",
      "loop-carousel": false
    },
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "󰖁",
          "type": "toggle",
          "active": true,
          "command": "swayosd-client --output-volume mute-toggle",
          "update-command": "sh -c 'set +e;pactl get-sink-mute @DEFAULT_SINK@ | grep -q \"no\" && echo true || echo false'"
        },
        {
          "label": "",
          "type": "toggle",
          "active": false,
          "command": "swayosd-client --input-volume mute-toggle",
          "update-command": "sh -c 'set +e;pactl get-source-mute @DEFAULT_SOURCE@ | grep -q \"yes\" && echo true || echo false'"
        },
        {
          "label": "󰀝",
          "type": "toggle",
          "active": true,
          "command": "sh -c '~/.config/swaync/scripts/toggle_airplanemode.sh'",
          "update-command": "sh -c 'set +e;[[ $(nmcli radio wifi) == \"enabled\" ]] || bluetoothctl show | grep -qF Powered:\\ yes && echo false || echo true'"
        },
        {
          "label": "",
          "type": "toggle",
          "active": true,
          "command": "sh -c '~/.config/swaync/scripts/toggle_hyprsunset.sh'",
          "update-command": "sh -c 'systemctl --user is-active --quiet hyprsunset.service && echo true || echo false'"
        },
        {
          "label": "",
          "type": "toggle",
          "active": true,
          "command": "sh -c '~/.config/swaync/scripts/toggle_hypridle.sh'",
          "update-command": "sh -c '~/.config/swaync/scripts/update_hypridle.sh'"
        },
        {
          "label": "",
          "type": "normal",
          "active": false,
          "command": "hyprpicker -a"
        }
      ]
    },
    "volume": {
      "label": "",
      "show-per-app-icon": true,
      "show-per-app": true
    },
    "backlight": {
      "label": "󰃠",
      "device": "intel_backlight",
      "subsystem": "backlight",
      "min": 5
    }
  },
  "script-fail-notify": false,
  "scripts": {
    "play-sound": {
      "exec": "~/.config/swaync/scripts/notify_sound.sh",
      "app-name": ".*",
      "run-on": "receive"
    }
  }
}
