{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 0,
  "margin-top": 1,
  "modules-left": ["custom/distro", "clock", "group/audio", "mpris"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    // "pulseaudio",
    "network",
    "tray",
    "custom/sysmon",
    "battery",
    "custom/notification"
    // "group/power",
  ],

  "custom/distro": {
    "format": "\uf303",
    "tooltip": false,
    "on-click": "rofi -show drun -theme ~/.config/rofi/launcher.rasi",
  },

  "clock": {
    "interval": 60,
    "format": "\uf017  {:%I:%M %p}",
    "format-alt": "\udb81\udd20  {:L%A, %B %d, %Y | \uf017  %I:%M %p}",
    "tooltip": true,
    "tooltip-format": "<big><b>{:%A, %d %B %Y}</b></big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "{}",
        "weeks": "<small>W{}</small>",
        "weekdays": "<b>{}</b>",
        "today": "<b><u>{}</u></b>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },

  "mpris": {
    "format": "{status_icon}  {dynamic}",
    "interval": 5,
    "dynamic-len": 40,
    "format-paused": "{status_icon}  {dynamic}",
    "format-stopped": "{status_icon}",
    "player-icons": {
      "default": "\udb85\udc7d",
      "spotify": "\uf1bc",
      "firefox": "\ue745",
      "chromium": "\udb80\udeaf",
    },
    "status-icons": {
      "playing": "\udb85\udc7d",
      "paused": "\udb80\udfe7",
      "stopped": "\uf28e",
    },
    "max-length": 35,
    "dynamic-order": ["title", "artist"],
    "ignored-players": [],
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip-format": "{title}\n{artist} · {album}\n{position} / {length}\n{player}",
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "persistent-workspaces": {
      "*": 3,
    },
  },

  "pulseaudio": {
    "format": "{icon}   {volume}% | {desc}",
    "format-bluetooth": "\udb80\udcb1  {volume}% |",
    "format-bluetooth-muted": "\udb81\udf5f |",
    "format-muted": "\udb81\udf5f  {desc}",
    "format-icons": {
      "headphone": "\uee58",
      "hands-free": "\uf590",
      "headset": "\uf025",
      "phone": "\uf095",
      "phone-muted": "\udb81\udf5f",
      "portable": "\uf10b",
      "car": "\uf1b9",
      "default": ["\uf027", "\uf028"],
    },
    "states": {
      "high": 90,
    },
    "tooltip-format": "{desc}\nVolume: {volume}%\nMic: {source_desc} · {source_volume}%",
    "max-length": 40,
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-middle": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "ignored-sinks": ["Easy Effects Sink"],
  },

  // ── Audio pill: volume | device name + bluetooth battery, merged into one pill ──
  "group/audio": {
    "orientation": "horizontal",
    "modules": ["pulseaudio", "bluetooth"],
  },

  // "battery-icon name" after the volume; hover it for the battery % (icon only appears if the device reports battery)
  "bluetooth": {
    "format": "",
    "format-off": "",
    "format-disabled": "",
    "format-on": "",
    "format-connected": "{device_alias}",
    "format-connected-battery": "\udb80\udc79 {device_alias}",
    "max-length": 24,
    "tooltip-format-connected-battery": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-middle": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +1%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -1%",
  },

  "network": {
    "interval": 2,
    "format": "{ifname}",
    "format-wifi": "\uf1eb   {essid} | \uf019  {bandwidthDownBits} | \uf093  {bandwidthUpBits}",
    "format-ethernet": "\uef44 | \uf019 {bandwidthDownBits} | \uf093 {bandwidthUpBits}",
    "format-linked": "\uef44 {ifname} (no IP)",
    "format-disconnected": "\udb81\uddaa",
    "tooltip-format": "{ifname}\nGateway: {gwaddr}",
    "tooltip-format-wifi": "{essid}  ({signalStrength}%)\n{ifname} · {frequency} GHz\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}\n\uf019 {bandwidthDownBits}   \uf093 {bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}\n\uf019 {bandwidthDownBits}   \uf093 {bandwidthUpBits}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty -e nmtui",
    "on-click-right": "nm-connection-editor",
    "max-length": 50,
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6,
  },

  "battery": {
    "interval": 10,
    "format": "{icon}  {capacity}%",
    "format-charging": "{icon}  {capacity}%",
    "format-plugged": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-icons": {
      "default": ["\udb80\udc8e", "\udb80\udc7a", "\udb80\udc7b", "\udb80\udc7c", "\udb80\udc7d", "\udb80\udc7e", "\udb80\udc7f", "\udb80\udc80", "\udb80\udc81", "\udb80\udc82", "\udb80\udc79"],
      "charging": ["\udb82\udc9c", "\udb82\udc9c", "\udb80\udc86", "\udb80\udc87", "\udb80\udc88", "\udb82\udc9d", "\udb80\udc89", "\udb82\udc9e", "\udb80\udc8a", "\udb80\udc8b", "\udb80\udc85"],
      "plugged": "\udb81\udea5",
    },
    "tooltip-format": "{capacity}% · {timeTo}\nPower: {power} W\nHealth: {health}% · {cycles} cycles",
    "states": {
      "warning": 30,
      "critical": 15,
    },
  },

  "custom/notification": {
    "tooltip": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "\udb84\udd6b",
      "none": "\udb80\udc9c",
      "dnd-notification": "\udb80\udca0",
      "dnd-none": "\udb82\ude93",
      "inhibited-notification": "\udb80\udc9b",
      "inhibited-none": "\udb82\ude91",
      "dnd-inhibited-notification": "\udb80\udc9b",
      "dnd-inhibited-none": "\udb82\ude91",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },

  // ── System monitor: icon + CPU% | MEM% on the pill, full stats in the hover tooltip ──
  "custom/sysmon": {
    "exec": "python3 ~/.config/waybar/scripts/sysmon.py",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "kitty -e btop",
  },

  // ── Power drawer (disabled) ────────────────────────────────────────────────
  // "group/power": {
  //   "orientation": "horizontal",
  //   "drawer": {
  //     "transition-duration": 500,
  //     "transition-left-to-right": false,
  //   },
  //   "modules": [
  //     "custom/shutdown",
  //     "custom/lock",
  //     "custom/reboot",
  //     "custom/logout",
  //   ],
  // },
  //
  // "custom/lock": {
  //   "format": "\udb80\udf41",
  //   "tooltip": false,
  //   "on-click": "hyprlock",
  // },
  //
  // "custom/reboot": {
  //   "format": "\udb81\udf09",
  //   "tooltip": false,
  //   "on-click": "systemctl reboot",
  // },
  //
  // "custom/shutdown": {
  //   "format": "\u23fb",
  //   "tooltip": false,
  //   "on-click": "systemctl poweroff",
  // },
  //
  // "custom/logout": {
  //   "format": "\udb80\udf43",
  //   "tooltip": false,
  //   "on-click": "hyprctl dispatch exit",
  // },
}
